# Server
PORT=8099

# Session
SESSION_SECRET=dev_only_do_not_use_in_prod // replace with a strong secret in production
# Auth
JWT_SECRET=change_me_in_production // replace with a strong secret in production

# Mongo 
MONGODB_URI=       // e.g., mongodb://localhost:27017
MONGODB_DB_NAME=rescash

# GraphQL Service (optional)
ENABLE_GRAPHQL=false
# e.g., http://localhost:4000/graphql
GRAPHQL_URI=http://<host>:<port>/graphql

# CROW Service (optional)
ENABLE_CROW=false
# e.g., http://localhost:5000/v1/transactions
CROW_SERVER_URI=http://<host>:<port>/v1/transactions
